# Copy to .env and fill in. Never commit .env.

# Required. HMAC key for signed image URLs. Any long random string.
# Generate one with: openssl rand -hex 32
STORAGE_SECRET=

# Optional. Public origin used in signed image URLs, e.g. http://1.2.3.4
# or https://dimension.example.com. Leave empty to derive it from each request.
PUBLIC_ORIGIN=

# Optional. Host port to publish on. Use 80 to serve on plain HTTP.
HOST_PORT=8080
